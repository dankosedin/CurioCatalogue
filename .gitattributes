# Line endings: the repository stores LF; checkout uses the platform's default, except where a tool needs a fixed one.
* text=auto
*.sln text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
*.pl  text eol=lf

*.png binary
*.dll binary
*.zip binary

# Golden stacks (docs/tests.md): kept byte for byte as the capture wrote them, the game's config file included.
CurioCatalogue.ServerTests/Golden/** -text
