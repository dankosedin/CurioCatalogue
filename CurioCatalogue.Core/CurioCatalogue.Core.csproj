<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the analyzer: a missed case in a switch over a [Closed] hierarchy or an enum is a build error. The types it looks
         for are our own (ExhaustiveMatching.cs); the package's dll is neither compiled against nor shipped. -->
    <PackageReference Include="ExhaustiveMatching.Analyzer" Version="0.5.0" ExcludeAssets="compile;runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
