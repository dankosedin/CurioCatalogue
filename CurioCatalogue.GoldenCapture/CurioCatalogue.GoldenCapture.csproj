<Project Sdk="Microsoft.NET.Sdk">

  <!-- Golden stacks (docs/plans/2026-11-04-backward-compat.md): the test server with our mod of a release, not the current build.
       A console program, run by hand once per release, so `dotnet test` and CI never run it. It compiles against the release's
       DLLs, taken from the zip of the GitHub release (checked by its hash), so it may use only the types that release has.
       It writes the golden set of the release into CurioCatalogue.ServerTests/Golden/v<version>/ (docs/tests.md, Golden stacks).
       Not built with the solution (no Build entry in curiocatalogue.sln): its build downloads the release. -->
  <Import Project="..\CurioCatalogue.TestServer\TestServer.Game.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ReleaseVersion>0.1.1</ReleaseVersion>
    <!-- The asset of the GitHub release v0.1.1, built by CI (the local Releases/ zip is a different build of the same tag). -->
    <ReleaseUrl>https://github.com/dankosedin/CurioCatalogue/releases/download/v$(ReleaseVersion)/curiocatalogue_$(ReleaseVersion).zip</ReleaseUrl>
    <ReleaseSha256>7AE7BF83C3B6F8A97108D0109BDC9243A18D178C712E47A4761845FCA84C06C2</ReleaseSha256>
    <ReleaseFolder>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)release\</ReleaseFolder>
    <ReleaseZip>$(ReleaseFolder)curiocatalogue_$(ReleaseVersion).zip</ReleaseZip>
    <ReleaseUnpacked>$(ReleaseFolder)unpacked-$(ReleaseVersion)\</ReleaseUnpacked>
  </PropertyGroup>

  <!-- Compiled against, never copied: the game's mod loader loads them from the zip it unpacks, and this program binds to that
       loaded copy by name (TestServer.props says why a copy in the bin would break it). -->
  <ItemGroup>
    <Reference Include="curiocatalogue"><HintPath>$(ReleaseUnpacked)curiocatalogue.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CurioCatalogue.Core"><HintPath>$(ReleaseUnpacked)CurioCatalogue.Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Not in an IDE's design-time build (opening the solution must not download). A zip whose hash does not match (a cut
       download, an error page) is deleted, so the next build downloads it again instead of failing on it every time. -->
  <Target Name="FetchRelease" BeforeTargets="ResolveAssemblyReferences;GetAssemblyAttributes"
          Condition="!Exists('$(ReleaseUnpacked)curiocatalogue.dll') And '$(DesignTimeBuild)' != 'true'">
    <DownloadFile SourceUrl="$(ReleaseUrl)" DestinationFolder="$(ReleaseFolder)" Condition="!Exists('$(ReleaseZip)')" />
    <VerifyFileHash File="$(ReleaseZip)" Hash="$(ReleaseSha256)" Algorithm="SHA256" ContinueOnError="true" />
    <Delete Files="$(ReleaseZip)" Condition="'$(MSBuildLastTaskResult)' == 'false'" />
    <Error Text="$(ReleaseZip) did not match ReleaseSha256 $(ReleaseSha256) and was deleted: build again to download it again, or check the hash" Condition="!Exists('$(ReleaseZip)')" />
    <Unzip SourceFiles="$(ReleaseZip)" DestinationFolder="$(ReleaseUnpacked)" />
  </Target>

  <!-- Read back by TestPaths: ModDll and ModAssets as the fixture expects them (here the unpacked release's), and the zip the
       server loads. -->
  <Target Name="ReleasePathsAsMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ModDll</_Parameter1>
        <_Parameter2>$(ReleaseUnpacked)curiocatalogue.dll</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ModAssets</_Parameter1>
        <_Parameter2>$(ReleaseUnpacked)assets</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ReleaseZip</_Parameter1>
        <_Parameter2>$(ReleaseZip)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ReleaseVersion</_Parameter1>
        <_Parameter2>$(ReleaseVersion)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ReleaseSha256</_Parameter1>
        <_Parameter2>$(ReleaseSha256)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GoldenFolder</_Parameter1>
        <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\CurioCatalogue.ServerTests\Golden\v$(ReleaseVersion)'))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
