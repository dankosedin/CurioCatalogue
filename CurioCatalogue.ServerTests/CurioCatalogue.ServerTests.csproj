<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests against a real game server started inside the test process (docs/tests.md, Server tests). The fixture,
       the references and the build steps are shared with CurioCatalogue.CompatTests through this import. -->
  <Import Project="..\CurioCatalogue.TestServer\TestServer.props" />

  <!-- Where the golden sets are (UpgradeTests, docs/tests.md, Golden stacks): read from the source folder, not copied. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoldenRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Golden'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
