<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests against a real game server started inside the test process (docs/development.md, Server tests). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The mod is built first, but its DLL is not referenced: the game's mod loader loads it from the mod's output (T4 of
       docs/plans/2026-11-02-server-tests.md decides how tests call our code). -->
  <ItemGroup>
    <ProjectReference Include="..\curiocatalogue\curiocatalogue.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Game DLLs are not copied: GameAssemblies (a module initializer) loads them from the game folder, so there is one copy
       of each, the one the game and its mods use. -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VintagestoryLib"><HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="xplatforminterface"><HintPath>$(VINTAGE_STORY)/Lib/xplatforminterface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>

  <!-- The test SDK brings Newtonsoft.Json 13.0.3; the game is built against 13.0.4. Both have assembly version 13.0.0.0 and
       only one is loaded: with the SDK's, ServerConfig.Save throws MissingMethodException (JToken.WriteTo). Use the game's. -->
  <Target Name="UseGameNewtonsoft" AfterTargets="Build">
    <Copy SourceFiles="$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll" DestinationFolder="$(OutDir)" />
  </Target>

  <!-- The paths the fixture needs, from MSBuild rather than hard-coded: the game folder the tests are built against, the
       built mod's DLL (its grandparent folder is a ModPaths entry, as addModPath in the launch profiles) and the mod's
       assets (an extra origin, as addOrigin there: a Debug build has no assets of its own). Read back by TestPaths. -->
  <Target Name="TestPathsAsMetadata" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\curiocatalogue\curiocatalogue.csproj" Targets="GetTargetPath" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_ModTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_ModDll>@(_ModTargetPath->'%(FullPath)')</_ModDll>
      <_ModProjectDir>@(_ModTargetPath->'%(MSBuildSourceProjectFile)'->DirectoryName())</_ModProjectDir>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GameDir</_Parameter1>
        <_Parameter2>$([System.IO.Path]::GetFullPath('$(VINTAGE_STORY)'))</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ModDll</_Parameter1>
        <_Parameter2>$(_ModDll)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ModAssets</_Parameter1>
        <_Parameter2>$([System.IO.Path]::Combine('$(_ModProjectDir)', 'assets'))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
