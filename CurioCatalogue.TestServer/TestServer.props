<Project>

  <!-- What every test project with a real game server shares (docs/development.md, Server tests): imported by
       CurioCatalogue.ServerTests and CurioCatalogue.CompatTests. The game's side (DLLs, the fixture's sources) is
       TestServer.Game.props; this file adds xUnit and our mod from its current build. -->

  <Import Project="$(MSBuildThisFileDirectory)TestServer.Game.props" />

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Tests compile against our DLLs but do not copy them: the game's mod loader loads them from the mod's output
       (Assembly.UnsafeLoadFrom, the default load context), and the tests bind to that same loaded copy by name. A copy in
       the test bin would be the one the game runs instead (LoadFrom returns an assembly of the same name from the app's
       own list). Core is named here too, or it would come in transitively and be copied. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\curiocatalogue\curiocatalogue.csproj" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\CurioCatalogue.Core\CurioCatalogue.Core.csproj" Private="false" />
  </ItemGroup>

  <!-- The paths of our mod the fixture needs, from MSBuild rather than hard-coded: the built mod's DLL (its grandparent folder
       is a ModPaths entry, as addModPath in the launch profiles) and the mod's assets (an extra origin, as addOrigin there: a
       Debug build has no assets of its own). Read back by TestPaths. -->
  <Target Name="TestPathsAsMetadata" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\curiocatalogue\curiocatalogue.csproj" Targets="GetTargetPath" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_ModTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_ModDll>@(_ModTargetPath->'%(FullPath)')</_ModDll>
      <_ModProjectDir>@(_ModTargetPath->'%(MSBuildSourceProjectFile)'->DirectoryName())</_ModProjectDir>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ModDll</_Parameter1>
        <_Parameter2>$(_ModDll)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ModAssets</_Parameter1>
        <_Parameter2>$([System.IO.Path]::Combine('$(_ModProjectDir)', 'assets'))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
