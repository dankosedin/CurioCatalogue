{
	code: "book",
	class: "CurioCatalogue.ItemLedger",
	maxstacksize: 1,
	// One item type for the three books (domain.md, Books): the ledger, the bill of materials and the album.
	// 1 = general inventory, 256 = off-hand. A book is held in the off-hand while posting invoices.
	storageFlags: 257,
	variantgroups: [
		{ code: "kind", states: ["ledger", "materials", "album"] },
		// The cover: vanilla book textures (domain.md, Covers). Keep the list stable: a removed state turns such books in a world into unknown items.
		{ code: "cover", states: [
			"normal-brickred", "normal-cherryred", "normal-darkbeige", "normal-darkgray", "normal-darkgreen", "normal-darkolive", "normal-gray", "normal-olive", "normal-orange", "normal-orangebrown", "normal-purple", "normal-purpleorange", "normal-teal",
			"aged-brickred", "aged-cherryred", "aged-darkbeige", "aged-darkgray", "aged-darkgreen", "aged-darkolive", "aged-gray", "aged-olive", "aged-orange", "aged-orangebrown", "aged-purpleorange"
		] }
	],
	behaviors: [
		{ name: "GroundStorable", properties: { layout: 'Quadrants', collisionBox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.125, z2: 1 } } }
	],
	attributes: {
		// Every cover has its own handbook page; groupBy only folds the recipe icons (modding.md, Handbook).
		handbook: {
			// Icons of "Ingredient for" and "Created by" are grouped per kind and age: aged and normal covers differ in their recipes.
			groupByByType: { "*-aged-*": ["book-{kind}-aged-*"], "*": ["book-{kind}-normal-*"] },
			extraSections: [
				// Each kind has its own section: {kind} is filled in as in variant codes.
				{ title: "curiocatalogue:handbook-use-title", text: "curiocatalogue:handbook-use-{kind}-text" },
				{ title: "curiocatalogue:handbook-sheets-title", text: "curiocatalogue:handbook-sheets-text" },
				{ title: "curiocatalogue:handbook-cover-title", text: "curiocatalogue:handbook-cover-text" }
			]
		},
		shelvable: true,
		displaycaseable: true,
		bookshelveable: true,
		displayable: {
			shelf: {
				category: "book",
				size: { width: 2, height: 5, length: 6 },
				randYRotAngle: 0
			}
		},
		groundStorageTransform: {
			translation: { x: 0.12, y: 0, z: -0.04 },
			rotation: { x: 0, y: 35, z: 90 },
			origin: { x: 0.5, y: 0.05, z: 0.5 }
		}
	},
	// The vanilla small book plus a label element on the front cover. Plain textures, no overlays (tools/textures.ps1 says why).
	shape: { base: "curiocatalogue:item/book" },
	textures: {
		"cover": { base: "game:item/lore/{cover}" },
		"label": { base: "curiocatalogue:item/book-{kind}" }
	},
	// Every cover, aged ones too: the handbook builds a page only for what is in the creative inventory (modding.md, Handbook).
	creativeinventory: { "general": ["*"], "items": ["*"] },
	guiTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: -180, y: 123, z: 33 },
		origin: { x: 0.48, y: 0.21, z: 0.5 },
		scaleXyz: { x: -3.23, y: 3.23, z: 3.23 }
	},
	tpHandTransform: {
		translation: { x: -0.79, y: -0.36, z: -0.73 },
		rotation: { x: 0, y: -84, z: 7 },
		origin: { x: 0.5, y: 0.1, z: 0.5 },
		scale: 0.67
	},
	groundTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: 0, y: 0, z: 90 },
		origin: { x: 0.41, y: 0, z: 0.5 },
		scale: 3.4
	}
}
